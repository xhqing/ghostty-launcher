{
  "name": "ghostty-launcher",
  "displayName": "Ghostty Launcher",
  "description": "Summon the external Ghostty terminal from VSCode: status bar button, plus 👻 panels in both the Primary and Secondary Side Bar with a New Window button and a live list of open Ghostty windows.",
  "version": "0.2.2",
  "publisher": "xhqing",
  "license": "MIT",
  "icon": "assets/icon.png",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "find . -name '*.js' -not -path './node_modules/*' -exec node --check {} +"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xhqing/ghostty-launcher.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ghosttyLauncher.show",
        "title": "Ghostty: Show Terminal (activate or start)"
      },
      {
        "command": "ghosttyLauncher.newWindow",
        "title": "Ghostty: New Terminal Window (in workspace)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ghostty-primary",
          "title": "Ghostty",
          "icon": "assets/activitybar.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "ghostty-secondary",
          "title": "Ghostty",
          "icon": "assets/activitybar.svg"
        }
      ]
    },
    "views": {
      "ghostty-primary": [
        {
          "type": "webview",
          "id": "ghosttyLauncher.windows",
          "name": "Ghostty"
        }
      ],
      "ghostty-secondary": [
        {
          "type": "webview",
          "id": "ghosttyLauncher.windowsSecondary",
          "name": "Ghostty"
        }
      ]
    }
  }
}
